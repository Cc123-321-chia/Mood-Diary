# Block directory listing
Options -Indexes

# Block access to .git and other sensitive dotfiles
RedirectMatch 404 /\.git
RedirectMatch 404 /\.env
RedirectMatch 404 /\.htaccess
RedirectMatch 404 /\.htpasswd

# Task C - HTTPS Enforcement
RewriteEngine On

# Block unencrypted API requests
RewriteCond %{HTTPS} !=on
RewriteRule ^api(/|$) - [F,L]

# Redirect HTTP pages to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://localhost/mood_diary/$1 [R=302,L]
